{
  "name": "cursor-chat-transit",
  "displayName": "Cursor Chat Transit",
  "description": "Move your Cursor chats between workspaces and devices.",
  "version": "1.0.0",
  "publisher": "oshokin",
  "icon": "resources/marketplace.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "chat",
    "export",
    "import"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oshokin/cursor-chat-transit.git"
  },
  "bugs": {
    "url": "https://github.com/oshokin/cursor-chat-transit/issues"
  },
  "homepage": "https://github.com/oshokin/cursor-chat-transit",
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "files": [
    "out/*.js",
    "out/*.js.map",
    "resources/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "vendor/**"
  ],
  "contributes": {
    "configuration": {
      "title": "Cursor Chat Transit",
      "properties": {
        "cursorChatTransit.userDataDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Local Cursor user-data directory. Empty means auto-detect."
        },
        "cursorChatTransit.sqlitePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the local sqlite3 executable."
        },
        "cursorChatTransit.plansDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the local Cursor plans directory. Empty uses ~/.cursor/plans. This does not change where Cursor saves new plans."
        },
        "cursorChatTransit.sqlite.operationTimeoutSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 30,
          "maximum": 3600,
          "scope": "machine",
          "description": "Maximum time for a SQLite query/process or one request on a persistent connection, in seconds. This is not a deadline for the entire transfer. Changes apply to the next transfer."
        },
        "cursorChatTransit.sqlite.busyTimeoutSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 30,
          "scope": "machine",
          "description": "SQLite busy-handler wait for supported lock contention, in seconds. This is not an operation deadline; some locks may still fail immediately. Changes apply to the next transfer."
        },
        "cursorChatTransit.logLevel": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "scope": "application",
          "markdownDescription": "Minimum level written to the operation log. `info` shows progress, warnings, and errors. `warn` shows warnings and errors. `error` shows failures only. Each line is marked INFO, WARN, or ERROR."
        },
        "cursorChatTransit.export.recoverText": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Fill missing message records in ZIP exports with labelled preview fragments or gap markers. Existing records, including empty messages, are kept. Does not restore missing full text or repair Cursor. Source data is unchanged."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorChatTransit",
          "title": "Cursor Chat Transit",
          "icon": "resources/icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "cursorChatTransit": [
        {
          "type": "webview",
          "id": "cursorChatTransit.view",
          "name": "Chat Transit",
          "icon": "resources/icons/activity-bar.svg"
        },
        {
          "id": "cursorChatTransit.manage",
          "name": "Manage chats",
          "icon": "resources/icons/activity-bar.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorChatTransit.export",
        "title": "Export Chats",
        "category": "Cursor Chat Transit",
        "icon": {
          "light": "resources/icons/export-light.svg",
          "dark": "resources/icons/export-dark.svg"
        }
      },
      {
        "command": "cursorChatTransit.import",
        "title": "Import Chats",
        "category": "Cursor Chat Transit",
        "icon": {
          "light": "resources/icons/import-light.svg",
          "dark": "resources/icons/import-dark.svg"
        }
      },
      {
        "command": "cursorChatTransit.exportCurrentWorkspace",
        "title": "Export Current Workspace",
        "category": "Cursor Chat Transit"
      },
      {
        "command": "cursorChatTransit.diagnostics",
        "title": "Diagnostics",
        "category": "Cursor Chat Transit",
        "icon": {
          "light": "resources/icons/diagnostics-light.svg",
          "dark": "resources/icons/diagnostics-dark.svg"
        }
      },
      {
        "command": "cursorChatTransit.showOutput",
        "title": "Open Operation Log",
        "category": "Cursor Chat Transit"
      },
      {
        "command": "cursorChatTransit.manageRefresh",
        "title": "Refresh",
        "category": "Cursor Chat Transit",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorChatTransit.manageCheck",
        "title": "Check selected item",
        "category": "Cursor Chat Transit",
        "icon": "$(graph)"
      },
      {
        "command": "cursorChatTransit.manageSearch",
        "title": "Find chats and workspaces\u2026",
        "category": "Cursor Chat Transit",
        "icon": "$(search)"
      },
      {
        "command": "cursorChatTransit.manageSelectAll",
        "title": "Select all visible workspaces",
        "category": "Cursor Chat Transit",
        "icon": "$(check-all)"
      },
      {
        "command": "cursorChatTransit.manageClearSelection",
        "title": "Clear selection",
        "category": "Cursor Chat Transit",
        "icon": "$(clear-all)"
      },
      {
        "command": "cursorChatTransit.manageShowAll",
        "title": "Show all workspaces",
        "category": "Cursor Chat Transit",
        "icon": "$(eye)"
      },
      {
        "command": "cursorChatTransit.manageShowRemovable",
        "title": "Hide empty or unavailable workspaces",
        "category": "Cursor Chat Transit",
        "icon": "$(eye-closed)"
      },
      {
        "command": "cursorChatTransit.manageCheckSelected",
        "title": "Check selected",
        "category": "Cursor Chat Transit",
        "icon": "$(graph)"
      },
      {
        "command": "cursorChatTransit.manageDelete",
        "title": "Delete checked history\u2026",
        "category": "Cursor Chat Transit",
        "icon": "$(trash)"
      },
      {
        "command": "cursorChatTransit.manageDeleteItem",
        "title": "Delete this history\u2026",
        "category": "Cursor Chat Transit",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorChatTransit.manageSearch",
          "when": "view == cursorChatTransit.manage",
          "group": "navigation@1"
        },
        {
          "command": "cursorChatTransit.manageRefresh",
          "when": "view == cursorChatTransit.manage",
          "group": "navigation@2"
        },
        {
          "command": "cursorChatTransit.manageSelectAll",
          "when": "view == cursorChatTransit.manage",
          "group": "navigation@4"
        },
        {
          "command": "cursorChatTransit.manageClearSelection",
          "when": "view == cursorChatTransit.manage",
          "group": "navigation@5"
        },
        {
          "command": "cursorChatTransit.manageShowAll",
          "when": "view == cursorChatTransit.manage && !cursorChatTransit.manageShowAll",
          "group": "navigation@3"
        },
        {
          "command": "cursorChatTransit.manageShowRemovable",
          "when": "view == cursorChatTransit.manage && cursorChatTransit.manageShowAll",
          "group": "navigation@3"
        },
        {
          "command": "cursorChatTransit.manageCheckSelected",
          "when": "view == cursorChatTransit.manage",
          "group": "navigation@6"
        },
        {
          "command": "cursorChatTransit.manageDelete",
          "when": "view == cursorChatTransit.manage",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorChatTransit.manageCheck",
          "when": "view == cursorChatTransit.manage && viewItem =~ /^managed(Workspace|Chat|ReadOnlyChat)$/",
          "group": "inline@1"
        },
        {
          "command": "cursorChatTransit.manageDelete",
          "when": "view == cursorChatTransit.manage && viewItem =~ /^(managedChat|managedWorkspace)$/ && cursorChatTransit.manageHasCheckedItems",
          "group": "inline@3"
        },
        {
          "command": "cursorChatTransit.manageDeleteItem",
          "when": "view == cursorChatTransit.manage && viewItem =~ /^(managedChat|managedWorkspace)$/ && !cursorChatTransit.manageHasCheckedItems",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "cursorChatTransit.manageRefresh",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageCheck",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageSearch",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageSelectAll",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageClearSelection",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageShowAll",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageShowRemovable",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageCheckSelected",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageDelete",
          "when": "false"
        },
        {
          "command": "cursorChatTransit.manageDeleteItem",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "watch": "node --import tsx scripts/watch.ts",
    "watch:src": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "watch:webview": "tsc -p tsconfig.webview.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx scripts/test-core.ts test",
    "test:watch": "node --import tsx scripts/test-core.ts --watch test",
    "test:unit": "node --import tsx scripts/test-core.ts --unit test",
    "test:sqlite": "node --import tsx scripts/test-core.ts --sqlite test",
    "test:host": "node --import tsx scripts/test-host.ts",
    "test:perf": "node --import tsx scripts/perf-statistics.ts && node --import tsx scripts/perf-bundle.ts",
    "check-package": "node --import tsx scripts/check-package.ts",
    "release:preview": "node --import tsx scripts/prepare-release.ts preview",
    "release:prepare": "node --import tsx scripts/prepare-release.ts prepare",
    "ensure-ci-sqlite": "node --import tsx scripts/ensure-ci-sqlite.ts",
    "check": "npm run compile && npm run typecheck && npm run lint && npm run format:check && npm test",
    "package:vsix": "node --import tsx scripts/prepare-dist.ts && vsce package --out dist/cursor-chat-transit.vsix",
    "package": "npm run check && npm run package:vsix",
    "vscode:prepublish": "npm run compile",
    "lint:complexity": "eslint src --rule \"max-lines-per-function: [warn, {max: 80, skipBlankLines: true, skipComments: true}]\" --rule \"complexity: [warn, 15]\"",
    "clean": "node --import tsx scripts/clean.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.6.4",
    "@types/semver": "7.8.0",
    "@types/vscode": "1.140.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "65.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "release-it": "21.1.0",
    "semver": "7.8.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.71.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "basic-ftp": "6.2.2",
    "qs": "6.16.0",
    "undici": "7.30.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.28.2": true
  }
}
